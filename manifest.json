{
  "manifest_version": 3,
  "name": "Custom New Tab URL",
  "version": "0.1.0",
  "description": "Automatically redirects new tabs to your custom configured URL with a clean fallback setup.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab/newtab.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}

